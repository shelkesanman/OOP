#include <iostream>
using namespace std;

class Employee
{
 public:
    
    int id;
    string name;
    float salaryperday;

 void display()
    {
        cout << "====Employee Details===="<< endl;
        cout << "Employee ID= "  <<id << endl;
        cout << "Employee Name= "<< name << endl;
        cout <<"Salary per day=  " <<salaryperday<<endl;
    }
};

int main()
{
    Employee e1;

    e1.id=1234;

    e1.name="sanman";

    e1.salaryperday=5600.45;

    e1.display();

    return 0;
}